import { ListView, ScrollView, Button, TextEdit } from "std-widgets.slint";

export struct ServerEntry {
    key: string,
    host: string,
}

export struct CommandEntry {
    key: string,
    name: string,
    desc: string,
}

component SelectableRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;

    height: 28px;
    background: touch.has-hover
        ? (root.selected ? #253f5a : #dde7f0)
        : (root.selected ? #1e3750 : transparent);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        x: 10px;
        width: parent.width - 10px;
        height: parent.height;
        text: root.label;
        color: root.selected ? #ffffff : #333333;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component AppWindow inherits Window {
    title: "Remote Command Runner";
    preferred-width: 1200px;
    preferred-height: 720px;
    background: #ebf0f7;

    in property <[ServerEntry]> servers;
    in property <[CommandEntry]> commands;
    in-out property <int> selected-server: -1;
    in-out property <int> selected-command: -1;
    in property <string> output-text: "";
    in property <bool> running: false;

    callback execute-clicked();
    callback clear-clicked();

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        // ── Left Panel ──────────────────────────────────────
        VerticalLayout {
            width: 320px;
            spacing: 8px;

            // Servers section
            Rectangle {
                height: 30px + 8 * 28px;
                background: #ffffff;
                border-radius: 6px;
                border-width: 1px;
                border-color: #c8d7e6;
                clip: true;

                VerticalLayout {
                    Rectangle {
                        height: 30px;
                        background: #1e3750;
                        Text {
                            x: 10px; width: parent.width - 10px; height: parent.height;
                            text: "Servers"; color: #ffffff;
                            font-size: 13px; vertical-alignment: center;
                        }
                    }
                    ListView {
                        for server[i] in root.servers: SelectableRow {
                            width: parent.width;
                            label: server.key + " : " + server.host;
                            selected: root.selected-server == i;
                            clicked => { root.selected-server = i; }
                        }
                    }
                }
            }

            // Commands section
            Rectangle {
                vertical-stretch: 1;
                background: #ffffff;
                border-radius: 6px;
                border-width: 1px;
                border-color: #c8d7e6;
                clip: true;

                VerticalLayout {
                    Rectangle {
                        height: 30px;
                        background: #1e3750;
                        Text {
                            x: 10px; width: parent.width - 10px; height: parent.height;
                            text: "Commands"; color: #ffffff;
                            font-size: 13px; vertical-alignment: center;
                        }
                    }
                    ListView {
                        for cmd[i] in root.commands: SelectableRow {
                            width: parent.width;
                            label: cmd.name + " : " + cmd.desc;
                            selected: root.selected-command == i;
                            clicked => { root.selected-command = i; }
                        }
                    }
                }
            }

            // Buttons row
            HorizontalLayout {
                height: 44px;
                spacing: 8px;
                alignment: start;

                Button {
                    text: "▶  Execute";
                    enabled: root.selected-server >= 0 && root.selected-command >= 0 && !root.running;
                    clicked => { root.execute-clicked(); }
                }
                Button {
                    text: "✕  Clear";
                    clicked => { root.clear-clicked(); }
                }
                if root.running: Text {
                    text: "Running...";
                    color: #505050;
                    vertical-alignment: center;
                }
            }
        }

        // ── Right Panel: Output ──────────────────────────────
        Rectangle {
            horizontal-stretch: 1;
            background: #ffffff;
            border-radius: 6px;
            border-width: 1px;
            border-color: #c8d7e6;
            clip: true;

            VerticalLayout {
                Rectangle {
                    height: 30px;
                    background: #1e3750;
                    Text {
                        x: 10px; width: parent.width - 10px; height: parent.height;
                        text: "Output"; color: #ffffff;
                        font-size: 13px; vertical-alignment: center;
                    }
                }
                TextEdit {
                    vertical-stretch: 1;
                    text: root.output-text;
                    read-only: true;
                    wrap: no-wrap;
                    font-size: 12px;
                }
            }
        }
    }
}
